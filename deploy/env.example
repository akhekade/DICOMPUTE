# Copy to .env or export before starting the coordinator.
DICO_HOST=0.0.0.0
DICO_PORT=7400
DICO_AUTH_DISABLED=false
DICO_BOOTSTRAP_API_KEY=sk-dico-change-me
DICO_DATA_DIR=/var/lib/dico
DICO_STORE_BACKEND=sqlite
DICO_BILLING_ENABLED=true
DICO_PRICE_INFER_MICRO_USD=100
DICO_RATE_LIMIT_RPM=120
DICO_LOG_LEVEL=INFO
DICO_LOG_JSON=true
DICO_METRICS_ENABLED=true
DICO_WS_PROVIDERS_ENABLED=true
DICO_OPENAI_COMPAT_ENABLED=true
